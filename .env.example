# =============================================
# Intelligent Data Dictionary — Environment
# =============================================

# Internal PostgreSQL (JARVIS metadata store)
DATABASE_URL=postgresql://postgres:password@localhost:5432/intelligent_dictionary

# Groq API Key (for LLM — get one at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# =============================================
# SECURITY (Required — app will NOT start without these)
# =============================================

# JWT signing key — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=your_jwt_secret_here

# Fernet key for encrypting stored DB passwords — generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DB_ENCRYPTION_KEY=your_fernet_key_here

# =============================================
# OPTIONAL
# =============================================

# Additional CORS origins (comma-separated)
# CORS_ORIGINS=https://yourdomain.com,https://staging.yourdomain.com
